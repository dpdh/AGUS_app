rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return signedIn() && request.auth.token.agusRole in roles;
    }

    function canManageProjects() {
      return hasRole(['super_admin', 'admin', 'project_manager']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole(['super_admin', 'admin']));
      allow create: if signedIn() && request.auth.uid == userId && !('agusRole' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('agusRole', null) == resource.data.get('agusRole', null);
      allow delete: if hasRole(['super_admin']);
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create, update: if canManageProjects();
      allow delete: if hasRole(['super_admin', 'admin']);

      match /evidence/{recordId} {
        allow read: if signedIn();
        allow create, update: if hasRole(['super_admin', 'admin', 'project_manager', 'member']);
        allow delete: if canManageProjects();
      }

      match /inspections/{recordId} {
        allow read: if signedIn();
        allow create, update: if hasRole(['super_admin', 'admin', 'project_manager', 'member']);
        allow delete: if canManageProjects();
      }

      match /{collection}/{recordId} {
        allow read: if signedIn();
        allow create, update, delete: if canManageProjects();
      }
    }
  }
}